# Public site settings. Everything here ends up in the browser bundle — never put secrets in this file.

# Production domain, no trailing slash. Used for the canonical URL, social previews, sitemap and robots.txt.
# TODO: replace with the real domain once it's registered.
VITE_SITE_URL=https://smarco.vercel.app

# WhatsApp number for the floating button and the form fallback (digits only, with country code).
VITE_WHATSAPP_NUMBER=237652370882

# Form service endpoint that accepts multipart POSTs, e.g. https://formspree.io/f/xxxxxxx
# Leave empty to send enquiries through WhatsApp instead.
VITE_FORM_ENDPOINT=
